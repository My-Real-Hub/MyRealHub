{
  "name": "my-real-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts tests/auth-callback.test.ts tests/auth-forms.test.ts tests/proxy.test.ts",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:dry-run": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "db:migrations": "supabase migration list"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "leaflet": "^1.9.4",
    "next": "^16.4.3",
    "nodemailer": "^10.1.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "supabase": "^2.101.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
